# Lab 17 API — distroless runtime (no shell)
# ---- builder ----
FROM golang:1.22-alpine AS builder
WORKDIR /src

COPY go.mod ./
# Ensure go.sum can be generated (avoid -mod=readonly style failures)
RUN go mod tidy
RUN go mod download

COPY . ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/mini-platform-api .

# ---- runtime ----
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /out/mini-platform-api /app/mini-platform-api
EXPOSE 8080
ENV PORT=8080
ENTRYPOINT ["/app/mini-platform-api"]
