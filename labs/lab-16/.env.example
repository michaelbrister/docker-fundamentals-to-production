# Lab 16 runtime configuration (non-secret)
APP_ENV=dev
LOG_LEVEL=info

# Release tag used for prod-like image runs
RELEASE_VERSION=0.3.0-rc.1

# DB connection (non-secret)
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_USER=app

# Optional latency injection (ms) so metrics change visibly
SIMULATE_LATENCY_MS=0
