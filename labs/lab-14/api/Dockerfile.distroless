# Lab 14 API — distroless (static) runtime: no shell, minimal surface area
# ---- builder ----
FROM golang:1.22-alpine AS builder
WORKDIR /src
RUN apk add --no-cache ca-certificates
# Copy module files first for better caching
COPY go.mod ./
# go.sum may not exist yet in beginner repos; wildcard COPY is safe
COPY go.sum* ./

# Download deps (cached layer). This may be incomplete if go.sum is missing entries.
RUN go mod download

# Copy source (now Go can see actual imports)
COPY . ./

# Ensure go.sum is complete based on the source imports
RUN go mod tidy

# Download deps again (now complete) to ensure build succeeds
RUN go mod download

# Build a static binary (no libc dependency)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/notes-api .

# ---- runtime ----
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /out/notes-api /app/notes-api
EXPOSE 8080
ENV PORT=8080
ENTRYPOINT ["/app/notes-api"]
